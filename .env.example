# Where model checkpoints are stored. Optional: defaults to ~/.cache/ragshield-ocr/hf_cache
# OCR_MODELS_DIR=/path/to/models
HANDWRITTEN_OCR_MODEL=sherif1313/Arabic-English-handwritten-OCR-v3
HANDWRITTEN_OCR_MAX_NEW_TOKENS=512
HANDWRITTEN_OCR_REPETITION_PENALTY=1.05

# Optional English handwritten TrOCR. Leave TROCR_CHECKPOINT_DIR empty to mark TrOCR as not configured.
# Defaults to <models dir>/microsoft__trocr-base-handwritten (not Arabic).
# TROCR_CHECKPOINT_DIR=
TROCR_MODEL_ID=microsoft/trocr-base-handwritten
TROCR_DEVICE=cpu
TROCR_MAX_NEW_TOKENS=64
TROCR_FULL_PAGE_MAX_NEW_TOKENS=256
OCR_RECOGNITION_MODE=qwen
