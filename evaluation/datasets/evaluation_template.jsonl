# split:
# Dataset partition used for evaluation, such as "eval", "train", or "test".

# task:
# Type of question or task. "factoid" means a question asking for a specific fact.

# answerable:
# Whether the available knowledge source contains enough information
# to answer the query. This does not guarantee successful retrieval.

# route_expected:
# Expected processing route for the query, such as "RAG".

# relevant_chunk_ids:
# IDs of the chunks judged relevant to answering the query.
# These must be actual chunk IDs from the indexed data.

# relevant_source_ids:
# IDs identifying the relevant source records or source files,
# according to the project's ID convention.

# relevant_document_ids:
# IDs of the relevant documents, according to the project's ID convention.

# relevant_image_source_ids:
# IDs of relevant image sources, if the query depends on images.
# Use an empty list when no image evidence is relevant.

# expected_evidence_ids:
# IDs of evidence items expected to support the answer.
# Follow the evaluation framework's convention for evidence IDs.

# relevance_judgments:
# Human or dataset judgments describing how relevant each chunk is.
# Each judgment can contain:
#   chunk_id: The actual ID of the judged chunk.
#   grade: Numeric relevance score; interpret using the project's rubric.
#   point_id: The Qdrant point ID, if used by the evaluator.
#   support_level: How well the chunk supports the answer.
#   note: Explanation of the judgment.

# reference_answer:
# The expected answer used as a reference during evaluation.

# key_facts:
# Essential facts expected in a correct answer.
# Used to measure coverage of the key information.

# claim_annotations:
# Annotations for claims made by the system's generated answer,
# such as whether each claim is supported, unsupported, or contradicted.
# Exact labels must follow the evaluator's schema.

# notes:
# Additional context, caveats, or explanations about the query and its labels.

