```dotenv
# ============================================================
# RAGShield — Environment Configuration Template
# ============================================================

# Application
APP_ENV=development

# ============================================================
# LLM / Qwen3-VL
# ============================================================

LLM_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
LLM_MODEL_PATH=models/qwen3-vl-8b
LLM_DEVICE=auto
LLM_QUANTIZATION=8bit
LLM_MAX_NEW_TOKENS=1024

# ============================================================
# LLM Runtime
# ============================================================

LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT=1
LLM_REQUIRE_MODEL_AT_STARTUP=true
LLM_MAX_IMAGE_BYTES=10485760
LLM_MAX_IMAGES=1
LLM_EXECUTOR_MAX_WORKERS=2

# ============================================================
# Retrieval
# ============================================================

RETRIEVAL_COLLECTION_NAME=ragshield_corpus
RETRIEVAL_DEFAULT_TOP_K=8
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=30
RETRIEVAL_SEARCH_TIMEOUT_SECONDS=30
RETRIEVAL_EXECUTOR_WORKERS=2
RETRIEVAL_ALLOW_DEGRADED_RESULTS=false

# ============================================================
# Reranker
# ============================================================

RERANKER_TOP_N=5
RERANKER_MAX_TOP_N=20
RERANKER_TIMEOUT_SECONDS=5
RERANKER_EXECUTOR_MAX_WORKERS=2
RERANKER_FALLBACK_TO_RETRIEVAL=true

# ============================================================
# Context
# ============================================================

CONTEXT_MAX_CONTEXT_TOKENS=2048
CONTEXT_MAX_EVIDENCE_ITEMS=10
CONTEXT_RESERVED_OUTPUT_TOKENS=1024
CONTEXT_RESERVED_SYSTEM_TOKENS=512
CONTEXT_ESTIMATED_CHARS_PER_TOKEN=4.0
CONTEXT_TOKENIZER_ENCODING=cl100k_base
CONTEXT_REQUIRE_EXACT_TOKENIZER=true

# ============================================================
# Prompt
# ============================================================

PROMPT_MAX_PROMPT_TOKENS=8192
PROMPT_OUTPUT_RESERVE_TOKENS=1024
PROMPT_TOKENIZER_ENCODING=cl100k_base
PROMPT_REQUIRE_EXACT_TOKENIZER=true
PROMPT_ESTIMATED_CHARS_PER_TOKEN=4.0
PROMPT_SAFETY_MODE=strict
```
